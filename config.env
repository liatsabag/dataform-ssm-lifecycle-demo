# =============================================================================
# Google Cloud Dataform Multi-Project Demo - Central Environment Configuration
# All deployment, verification, and lifecycle scripts read configuration from here.
# =============================================================================

# GCP Project Names (User-Controlled Display Names)
export DEV_PROJECT_NAME="df-demo-dev"
export PROD_PROJECT_NAME="df-demo-prod"
export SSM_PROJECT_NAME="df-demo-ssm"

# Resolved GCP Project IDs (Auto-managed & updated by 01_provision_projects.sh)
export DEV_PROJECT="df-demo-dev-1c3da"
export PROD_PROJECT="df-demo-prod-de4d1"
export SSM_PROJECT="df-demo-ssm-42c6d"

# GCP Organization & Billing Settings (Leave empty for automatic detection via gcloud)
export BILLING_ID=""
export FOLDER_ID=""

# Geographic Region / Location
export LOCATION="me-west1"

# Developer & Workspace Identities
export DEVELOPER="bob@liatsabag.altostrat.com"
export DEVELOPER_WORKSPACE="bob"

# Secure Source Manager (SSM) & Developer Connect
export INSTANCE_ID="df-source-instance"
export REPO_ID="dataform-pipeline"
export DEFAULT_BRANCH="development"
export CONN_ID="ssm-conn"

# Pipeline Service Account
export EXECUTOR_SA="dataform-executor@${DEV_PROJECT}.iam.gserviceaccount.com"

# BigQuery Source & Target Datasets
export SOURCE_PROJECT="${PROD_PROJECT}"
export SOURCE_DATASET="raw_vault"
export TARGET_PROJECT="${DEV_PROJECT}"
export TARGET_DATASET="analytics_curated"
export ASSERTION_DATASET="dataform_assertions"
