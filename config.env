# =============================================================================
# Google Cloud Dataform Multi-Project Demo - Environment Configuration
# Edit the variables below before executing ./scripts/00_deploy_all.sh
# =============================================================================

# Auto-configure Python interpreter with pyOpenSSL for gcloud CLI
if [ -z "${CLOUDSDK_PYTHON:-}" ]; then
  if [ -x "/opt/homebrew/bin/python3" ]; then
    export CLOUDSDK_PYTHON="/opt/homebrew/bin/python3"
  elif [ -x "/usr/local/bin/python3" ]; then
    export CLOUDSDK_PYTHON="/usr/local/bin/python3"
  fi
fi
export CLOUDSDK_PYTHON_SITEPACKAGES=1

# GCP Project Display Names (Used to name and provision the 3 isolated environments)
export DEV_PROJECT_NAME="df-demo-dev"
export PROD_PROJECT_NAME="df-demo-prod"
export SSM_PROJECT_NAME="df-demo-ssm"

# Resolved GCP Project IDs (Auto-managed & updated by 01_provision_projects.sh)
export DEV_PROJECT=""
export PROD_PROJECT=""
export SSM_PROJECT=""

# Geographic Region / Location for BigQuery, Dataform & Secure Source Manager
export LOCATION="me-west1"

# Developer Identity & Workspace Name for the Demo
export DEVELOPER="bob@liatsabag.altostrat.com"
export DEVELOPER_WORKSPACE="bob"

# Optional: GCP Organization & Billing Settings (Leave empty for automatic detection)
export BILLING_ID=""
export FOLDER_ID=""

# Secure Source Manager (SSM) & Developer Connect IDs
export INSTANCE_ID="df-source-instance"
export REPO_ID="dataform-pipeline"
export DEFAULT_BRANCH="development"
export CONN_ID="ssm-conn"

# BigQuery Dataset Configurations
export SOURCE_DATASET="raw_vault"
export TARGET_DATASET="analytics_curated"
export ASSERTION_DATASET="dataform_assertions"
